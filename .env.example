## CtrlX environment template
## Copy to `.env` for local development

# Postgres (Docker Compose default)
DATABASE_URL=postgresql://ctrlx:ctrlx@localhost:5432/ctrlx

# Required in production — strong random secret
JWT_SECRET=dev-only-jwt-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# Default SuperAdmin (created on seed / first boot)
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme
AUTH_EMAIL=admin@localhost

# CORS (comma-separated). Empty = reflect any origin in dev.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173,http://localhost:5000

ENCRYPTION_KEY=dev-only-encryption-key-change-me

# Frontend
VITE_ENABLE_WS=false
VITE_API_BASE_URL=
VITE_API_CREDENTIALS=include

# --- Netlify (set in Site settings → Environment variables) ---
# NETLIFY=true
# DATABASE_URL=postgresql://...@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# JWT_SECRET=strong-random-secret
# ENCRYPTION_KEY=strong-random-32-char-key!!
# CORS_ORIGIN=https://your-frontend.example.com
# DISABLE_AUTOMATION_SCHEDULER=true
# DISABLE_HEARTBEAT_SCHEDULER=true
# HEARTBEAT_SCHEDULER_MS=300000
# HEARTBEAT_CRON_CONCURRENCY=5

# Optional email (legacy 2FA flows)
RESEND_API_KEY=
EMAIL_FROM=noreply@localhost

# Legacy single-tenant Home Assistant proxy (Phase 3 will replace)
HA_BASE_URL=
HA_TOKEN=
